{
  "info": {
    "name": "Destiny Ride-Booking Platform API",
    "_postman_id": "c1f7a40b-e483-433e-b7d1-destiny-api-v1",
    "description": "Comprehensive Postman Collection covering all Phase 1 Backend APIs for Destiny Ride-Booking Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "driver_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "ride_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicle_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "payment_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Passenger",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"passenger@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "{{base_url}}/auth/register/"
          }
        },
        {
          "name": "Register Driver",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Ravi Kumar\",\n  \"email\": \"driver@example.com\",\n  \"phone\": \"9876543211\",\n  \"password\": \"SecurePass123!\",\n  \"license_number\": \"OD-07-20230001234\"\n}"
            },
            "url": "{{base_url}}/auth/register/driver/"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.access) {",
                  "    pm.collectionVariables.set('access_token', jsonData.data.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.data.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "{{base_url}}/auth/login/"
          }
        },
        {
          "name": "Token Refresh",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/token/refresh/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/logout/"
          }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/users/me/"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Updated Doe\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": "{{base_url}}/users/me/"
          }
        }
      ]
    },
    {
      "name": "3. Drivers",
      "item": [
        {
          "name": "Get Driver Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/drivers/me/"
          }
        },
        {
          "name": "Update Driver Profile",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"license_number\": \"OD-07-20239999999\",\n  \"full_name\": \"Ravi K. Updated\"\n}"
            },
            "url": "{{base_url}}/drivers/me/"
          }
        },
        {
          "name": "Toggle Online/Offline Status",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_online\": true\n}"
            },
            "url": "{{base_url}}/drivers/status/"
          }
        },
        {
          "name": "Get Nearby Drivers",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/drivers/nearby/?latitude=19.3149&longitude=84.7941&radius_km=10"
          }
        },
        {
          "name": "Get Driver Details",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/drivers/{{driver_id}}/"
          }
        },
        {
          "name": "Get Driver Earnings",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/drivers/earnings/"
          }
        },
        {
          "name": "Get Driver Ratings",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/drivers/{{driver_id}}/ratings/"
          }
        }
      ]
    },
    {
      "name": "4. Vehicles",
      "item": [
        {
          "name": "Add Vehicle",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_number\": \"OD-07-AB-1234\",\n  \"vehicle_model\": \"Swift Dzire\",\n  \"vehicle_type\": \"CAR\",\n  \"vehicle_color\": \"White\"\n}"
            },
            "url": "{{base_url}}/vehicles/"
          }
        },
        {
          "name": "Get My Vehicles",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/vehicles/me/"
          }
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_model\": \"Swift Dzire VXI\",\n  \"vehicle_color\": \"Silver\"\n}"
            },
            "url": "{{base_url}}/vehicles/{{vehicle_id}}/"
          }
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/vehicles/{{vehicle_id}}/"
          }
        }
      ]
    },
    {
      "name": "5. Locations",
      "item": [
        {
          "name": "Update Driver GPS Location",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 19.3149,\n  \"longitude\": 84.7941\n}"
            },
            "url": "{{base_url}}/locations/update/"
          }
        },
        {
          "name": "Get Driver Location",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/locations/driver/{{driver_id}}/"
          }
        }
      ]
    },
    {
      "name": "6. Fares",
      "item": [
        {
          "name": "Get Fare Estimate",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup_latitude\": 19.3149,\n  \"pickup_longitude\": 84.7941,\n  \"destination_latitude\": 19.3500,\n  \"destination_longitude\": 84.8200\n}"
            },
            "url": "{{base_url}}/fares/estimate/"
          }
        }
      ]
    },
    {
      "name": "7. Rides",
      "item": [
        {
          "name": "Create Ride Request",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup_address\": \"Market Square, Main Gate\",\n  \"pickup_latitude\": 19.3149,\n  \"pickup_longitude\": 84.7941,\n  \"destination_address\": \"Railway Station, Platform 1\",\n  \"destination_latitude\": 19.3500,\n  \"destination_longitude\": 84.8200\n}"
            },
            "url": "{{base_url}}/rides/"
          }
        },
        {
          "name": "Get Ride Details",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/rides/{{ride_id}}/"
          }
        },
        {
          "name": "Get Passenger Ride History",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/rides/my-rides/"
          }
        },
        {
          "name": "Get Driver Ride Requests",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/rides/requests/"
          }
        },
        {
          "name": "Driver Accepts Ride",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/rides/{{ride_id}}/accept/"
          }
        },
        {
          "name": "Driver Rejects Ride",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/rides/{{ride_id}}/reject/"
          }
        },
        {
          "name": "Update Ride Status",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DRIVER_ARRIVING\"\n}"
            },
            "url": "{{base_url}}/rides/{{ride_id}}/status/"
          }
        },
        {
          "name": "Cancel Ride",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my destination plans\"\n}"
            },
            "url": "{{base_url}}/rides/{{ride_id}}/cancel/"
          }
        }
      ]
