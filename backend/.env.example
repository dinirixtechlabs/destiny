# ==============================================
# destiny Backend Environment Variables
# ==============================================

# Django Core
SECRET_KEY=django-insecure-destiny-platform-dev-secret-key-change-in-prod
DEBUG=True
DJANGO_SETTINGS_MODULE=destiny.settings
DJANGO_LOG_LEVEL=DEBUG

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:3000

# Database (Supabase PostgreSQL)
# Option A: Full Connection String (Transaction Pooler or Session Pooler / Direct)
DATABASE_URL=postgresql://postgres:your_password@db.your-supabase-id.supabase.co:5432/postgres

# Option B: Individual Database Parameters (Used if DATABASE_URL is not set)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=db.your-supabase-id.supabase.co
DB_PORT=5432

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

